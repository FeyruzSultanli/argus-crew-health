{
  "name": "argus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ARGUS — Crew health autonomy (NASA Space Apps Challenge 2026)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:seed": "tsx scripts/build-handbook-index.ts && tsx scripts/sync-seed.ts",
    "predev": "npm run sync:seed",
    "dev": "vite",
    "prebuild": "npm run sync:seed",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:subpath": "playwright test -c playwright.subpath.config.ts",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts --workers=1",
    "test:e2e:prod:subpath": "ARGUS_E2E_BASE=/argus-crew-health/ playwright test -c playwright.prod.config.ts --workers=1",
    "make:icons": "tsx scripts/make-icons.ts",
    "precache:report": "tsx scripts/precache-report.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "fetch:data": "tsx scripts/fetch-data.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "build:anatomy": "node --max-old-space-size=8192 --import tsx scripts/build-anatomy.ts",
    "slides:build": "node scripts/submission/build-slides.mjs",
    "video:record": "node scripts/submission/record-video.mjs",
    "video:assemble": "bash scripts/submission/assemble-video.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
